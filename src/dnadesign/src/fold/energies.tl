-- Create RNA and DNA energy parameter sets
local rna_energies: Energies = {
    bulgeLoops = rnaBulgeLoops,
    complement = function(base: string): string
        return rnaComplement[base]
    end,
    danglingEnds = rnaDanglingEnds,
    hairpinLoops = rnaHairpinLoops,
    multibranch = rnaMultibranch,
    internalLoops = rnaInternalLoops,
    internalMismatches = rnaInternalMismatches,
    nearestNeighbors = rnaNearestNeighbors,
    terminalMismatches = rnaTerminalMismatches,
    triTetraLoops = nil
}

local dna_energies: Energies = {
    bulgeLoops = dnaBulgeLoops,
    complement = function(base: string): string
        return dnaComplement[base]
    end,
    danglingEnds = dnaDanglingEnds,
    hairpinLoops = dnaHairpinLoops,
    multibranch = dnaMultibranch,
    internalLoops = dnaInternalLoops,
    internalMismatches = dnaInternalMismatches,
    nearestNeighbors = dnaNearestNeighbors,
    terminalMismatches = dnaTerminalMismatches,
    triTetraLoops = dnaTriTetraLoops
}

energies.Energy = Energy
energies.Energies = Energies
energies.MatchingBasepairEnergy = MatchingBasepairEnergy
energies.LoopEnergy = LoopEnergy
energies.MultiBranchEnergies = MultiBranchEnergies
energies.rna_energies = rna_energies
energies.dna_energies = dna_energies
energies.delta_g = delta_g
energies.jacobson_stockmayer = jacobson_stockmayer

return energies
