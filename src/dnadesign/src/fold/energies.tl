-- energies.tl
-- This module contains all energy parameters for RNA and DNA folding

local record energies
	Energy: Energy
	Energies: Energies
	MatchingBasepairEnergy: MatchingBasepairEnergy
	LoopEnergy: LoopEnergy
	MultiBranchEnergies: MultiBranchEnergies

	rna_energies: Energies 
    dna_energies: Energies

    -- Utility functions
    delta_g: function(enthalpyH: number, entropyS: number, temp: number): number
    jacobson_stockmayer: function(query_len: integer, known_len: integer, dg_x: number, temp: number): number
end

-- Implement the utility functions
local function delta_g(enthalpyH: number, entropyS: number, temp: number): number
    return enthalpyH - temp * (entropyS/1000.0)
end

local function jacobson_stockmayer(query_len: integer, known_len: integer, dg_x: number, temp: number): number
    local gas_constant = 1.9872e-3
    return dg_x + 2.44 * gas_constant * temp * math.log(query_len/known_len)
end

-- Basic type definitions
local record Energy
    enthalpyH: number
    entropyS: number 
end

local type MatchingBasepairEnergy = {string:Energy}
local type LoopEnergy = {integer:Energy}

local record MultiBranchEnergies
    helicesCount: number
    unpairedCount: number
    coaxialStackCount: number
    terminalMismatchCount: number
end

local record Energies
    bulgeLoops: LoopEnergy
    complement: function(string): string
    danglingEnds: MatchingBasepairEnergy
    hairpinLoops: LoopEnergy
    multibranch: MultiBranchEnergies
    internalLoops: LoopEnergy
    internalMismatches: MatchingBasepairEnergy
    nearestNeighbors: MatchingBasepairEnergy
    terminalMismatches: MatchingBasepairEnergy
    triTetraLoops: MatchingBasepairEnergy | nil
end

